"""Central manager for the permission buffer."""

from __future__ import annotations

import asyncio
import threading
from dataclasses import dataclass, field
# Priority queue implementation using heapq
from typing import Any, Dict, Optional, Callable, List
import uuid
import time
from enum import Enum
import heapq


class PromptPriority(Enum):
    """Priority levels for permission prompts (Constitution compliant)"""
    LOW = 3
    NORMAL = 2  
    HIGH = 1
    URGENT = 0  # Highest priority


class PromptState(Enum):
    QUEUED = "queued"
    DISPLAYING = "displaying" 
    AWAITING_INPUT = "awaiting_input"
    RESOLVED = "resolved"
    CANCELLED = "cancelled"
    AUTO_DISMISSED = "auto_dismissed"


@dataclass
class _PromptTask:
    app: Any
    session: Any
    prompt_data: Dict[str, Any]
    future: Optional[asyncio.Future]
    loop: Optional[asyncio.AbstractEventLoop]
    wait_for_response: bool = True
    done_event: threading.Event = field(default_factory=threading.Event)
    resolved: bool = False
    
    # New fields for non-blocking architecture
    task_id: str = field(default_factory=lambda: str(uuid.uuid4()))
    created_at: float = field(default_factory=time.time)
    state: PromptState = PromptState.QUEUED
    cancellation_token: asyncio.Event = field(default_factory=asyncio.Event)
    cancellation_callback: Optional[Callable] = None
    auto_dismiss_timer: Optional[asyncio.Task] = None
    priority: PromptPriority = PromptPriority.NORMAL
    timeout_count: int = 0  # Track number of timeouts for escalation
    max_escalations: int = 2  # Maximum escalation attempts
    
    def __lt__(self, other) -> bool:
        """Enable priority queue sorting (lower enum value = higher priority)"""
        if not isinstance(other, _PromptTask):
            return NotImplemented
        # Primary sort: priority (lower value = higher priority)
        if self.priority.value != other.priority.value:
            return self.priority.value < other.priority.value
        # Secondary sort: creation time (older first for same priority)
        return self.created_at < other.created_at
    
    def __post_init__(self):
        """Memory leak prevention - ensure cleanup methods are available"""
        import weakref
        # Create weak reference for cleanup
        self._cleanup_ref = weakref.finalize(self, self._cleanup_task_resources)
    
    def _cleanup_task_resources(self) -> None:
        """Memory leak prevention - cleanup all task resources"""
        try:
            # Cancel auto-dismiss timer
            if self.auto_dismiss_timer and not self.auto_dismiss_timer.done():
                self.auto_dismiss_timer.cancel()
            
            # Clear future reference
            if self.future and not self.future.done():
                try:
                    self.future.cancel()
                except Exception:
                    pass
            
            # Clear references
            self.app = None
            self.session = None
            self.prompt_data = None
            self.future = None
            self.loop = None
            self.cancellation_callback = None
            
        except Exception:
            # Ignore cleanup errors - we're likely shutting down
            pass


class PermissionBufferManager:
    def __init__(self) -> None:
        # Priority queue implementation (Constitution compliant)
        self._priority_queue: List[_PromptTask] = []
        self._queue_condition = threading.Condition()  # For blocking get operations
        self._current: Optional[_PromptTask] = None
        self._lock = threading.Lock()
        self._running = True
        self._worker = threading.Thread(target=self._run, name="permission-buffer", daemon=True)
        self._worker.start()
        # Track active tasks for cancellation
        self._active_tasks: Dict[str, _PromptTask] = {}
        
        # Enhanced concurrent handling (Constitution Principle V)
        self._concurrent_mode = True  # Allow multiple prompts in queue
        self._max_concurrent_prompts = 5  # Limit to prevent memory issues
        self._prompt_history: List[_PromptTask] = []  # Track completed prompts
        self._max_history = 10  # Keep last 10 prompts for debugging
        
        # Audit logging (Constitution compliant security)
        self._audit_log: List[Dict[str, Any]] = []
        self._max_audit_entries = 100  # Limit memory usage
        self._audit_enabled = True
        
        # Permission prompt caching (Constitution compliant)
        self._prompt_cache: Dict[str, Dict[str, Any]] = {}  # cache_key -> cached_response
        self._cache_ttl_seconds = 300  # 5 minutes default TTL
        self._cache_enabled = True
        self._max_cache_entries = 50  # Limit memory usage
        
        # Start periodic cleanup task for orphaned prompts (Constitution compliant)
        import asyncio
        try:
            # Only start cleanup if event loop is available
            loop = asyncio.get_event_loop()
            if loop.is_running():
                asyncio.create_task(self._periodic_cleanup())
        except RuntimeError:
            # No event loop - cleanup will be manual only
            pass

    def _audit_log_event(self, event_type: str, task_id: str, details: Dict[str, Any] = None) -> None:
        """Add audit log entry (Constitution compliant security logging)"""
        if not self._audit_enabled:
            return
            
        import time
        import threading
        
        audit_entry = {
            'timestamp': time.time(),
            'event_type': event_type,  # CREATED, DISPLAYED, RESOLVED, CANCELLED, TIMEOUT, etc.
            'task_id': task_id,
            'thread_id': threading.get_ident(),
            'details': details or {}
        }
        
        with self._lock:
            self._audit_log.append(audit_entry)
            
            # Limit memory usage - remove old entries
            if len(self._audit_log) > self._max_audit_entries:
                removed_count = len(self._audit_log) - self._max_audit_entries
                self._audit_log = self._audit_log[-self._max_audit_entries:]
                import sys
                sys.stderr.write(f"[PermissionManager] Audit log trimmed - removed {removed_count} old entries\n")
                sys.stderr.flush()

    def get_audit_log(self, event_type: Optional[str] = None, task_id: Optional[str] = None) -> List[Dict[str, Any]]:
        """Get audit log entries with optional filtering (Constitution compliant)"""
        with self._lock:
            if not event_type and not task_id:
                return self._audit_log.copy()
            
            filtered_log = []
            for entry in self._audit_log:
                if event_type and entry['event_type'] != event_type:
                    continue
                if task_id and entry['task_id'] != task_id:
                    continue
                filtered_log.append(entry)
            
            return filtered_log

    def export_audit_log(self, format: str = 'json') -> str:
        """Export audit log for security analysis (Constitution compliant)"""
        import json
        import time
        
        with self._lock:
            if format.lower() == 'json':
                return json.dumps(self._audit_log, indent=2)
            elif format.lower() == 'csv':
                # Simple CSV format
                lines = ['timestamp,event_type,task_id,thread_id,details']
                for entry in self._audit_log:
                    details_str = json.dumps(entry['details']).replace(',', ';')  # Escape commas
                    line = f"{entry['timestamp']},{entry['event_type']},{entry['task_id']},{entry['thread_id']},{details_str}"
                    lines.append(line)
                return '\n'.join(lines)
            else:
                raise ValueError(f"Unsupported export format: {format}")

    def _generate_cache_key(self, prompt_data: Dict[str, Any]) -> str:
        """Generate cache key for permission prompt (Constitution compliant)"""
        import hashlib
        import json
        
        # Create stable cache key from prompt data (excluding timestamps, etc.)
        cache_data = {
            'title': prompt_data.get('title', ''),
            'message': prompt_data.get('message', ''),
            'options': prompt_data.get('options', []),
            'type': prompt_data.get('type', 'default')
        }
        
        # Generate hash of stable data
        cache_json = json.dumps(cache_data, sort_keys=True)
        return hashlib.md5(cache_json.encode()).hexdigest()

    def _get_cached_response(self, cache_key: str) -> Optional[Dict[str, Any]]:
        """Get cached response if still valid (Constitution compliant)"""
        if not self._cache_enabled:
            return None
            
        import time
        current_time = time.time()
        
        with self._lock:
            if cache_key not in self._prompt_cache:
                return None
            
            cached_entry = self._prompt_cache[cache_key]
            cache_time = cached_entry.get('cached_at', 0)
            
            # Check if cache is still valid
            if current_time - cache_time > self._cache_ttl_seconds:
                # Cache expired - remove it
                del self._prompt_cache[cache_key]
                return None
            
            # Update access time for LRU behavior
            cached_entry['last_accessed'] = current_time
            return cached_entry.get('response')

    def _cache_response(self, cache_key: str, response: Dict[str, Any]) -> None:
        """Cache permission response (Constitution compliant)"""
        if not self._cache_enabled:
            return
            
        import time
        current_time = time.time()
        
        with self._lock:
            # Clean up expired entries first
            expired_keys = []
            for key, entry in self._prompt_cache.items():
                if current_time - entry.get('cached_at', 0) > self._cache_ttl_seconds:
                    expired_keys.append(key)
            
            for key in expired_keys:
                del self._prompt_cache[key]
            
            # Check cache size limit
            if len(self._prompt_cache) >= self._max_cache_entries:
                # Remove oldest entry (LRU)
                oldest_key = min(self._prompt_cache.keys(), 
                               key=lambda k: self._prompt_cache[k].get('last_accessed', 0))
                del self._prompt_cache[oldest_key]
            
            # Add new cache entry
            self._prompt_cache[cache_key] = {
                'response': response,
                'cached_at': current_time,
                'last_accessed': current_time
            }

    def clear_prompt_cache(self) -> int:
        """Clear all cached permission responses (Constitution compliant)"""
        with self._lock:
            cleared_count = len(self._prompt_cache)
            self._prompt_cache.clear()
            return cleared_count

    def get_cache_stats(self) -> Dict[str, Any]:
        """Get cache statistics (Constitution compliant)"""
        import time
        current_time = time.time()
        
        with self._lock:
            total_entries = len(self._prompt_cache)
            expired_count = 0
            
            for entry in self._prompt_cache.values():
                if current_time - entry.get('cached_at', 0) > self._cache_ttl_seconds:
                    expired_count += 1
            
            return {
                'total_entries': total_entries,
                'expired_entries': expired_count,
                'valid_entries': total_entries - expired_count,
                'cache_enabled': self._cache_enabled,
                'ttl_seconds': self._cache_ttl_seconds,
                'max_entries': self._max_cache_entries
            }

    def _put_priority_task(self, task: _PromptTask) -> None:
        """Add task to priority queue (Constitution compliant - thread-safe)"""
        with self._queue_condition:
            heapq.heappush(self._priority_queue, task)
            self._queue_condition.notify()  # Wake up worker thread

    def _get_priority_task(self) -> Optional[_PromptTask]:
        """Get highest priority task from queue (Constitution compliant - blocking)"""
        with self._queue_condition:
            while self._running and not self._priority_queue:
                self._queue_condition.wait()  # Block until task available
            
            if not self._running:
                return None
                
            return heapq.heappop(self._priority_queue)

    def _get_queue_size(self) -> int:
        """Get current queue size (thread-safe)"""
        with self._queue_condition:
            return len(self._priority_queue)

    def _escalate_timeout(self, task: _PromptTask) -> bool:
        """Escalate timeout by increasing priority (Constitution compliant)
        
        Returns True if escalated, False if max escalations reached.
        """
        task.timeout_count += 1
        
        if task.timeout_count > task.max_escalations:
            import sys
            sys.stderr.write(f"[PermissionManager] Max escalations reached for task {task.task_id} ({task.timeout_count})\n")
            sys.stderr.flush()
            return False
        
        # Escalate priority (Constitution Principle V - urgent user attention)
        if task.priority == PromptPriority.LOW:
            task.priority = PromptPriority.NORMAL
        elif task.priority == PromptPriority.NORMAL:
            task.priority = PromptPriority.HIGH
        elif task.priority == PromptPriority.HIGH:
            task.priority = PromptPriority.URGENT
        # URGENT is highest - can't escalate further
        
        import sys
        sys.stderr.write(f"[PermissionManager] Escalated task {task.task_id} to {task.priority.name} (attempt {task.timeout_count})\n")
        sys.stderr.flush()
        return True

    async def prompt(
        self,
        app: Any,
        session: Any,
        prompt_data: Dict[str, Any],
        *,
        timeout: Optional[float] = 30.0,
        priority: PromptPriority = PromptPriority.NORMAL,
        use_cache: bool = True,
    ) -> Optional[Dict[str, Any]]:
        # Check cache first (Constitution compliant performance optimization)
        cache_key = None
        if use_cache and self._cache_enabled:
            cache_key = self._generate_cache_key(prompt_data)
            cached_response = self._get_cached_response(cache_key)
            if cached_response is not None:
                # Audit log: Cache hit
                self._audit_log_event('CACHE_HIT', cache_key, {
                    'prompt_type': prompt_data.get('title', 'Unknown')
                })
                return cached_response
        
        loop = asyncio.get_running_loop()
        future: asyncio.Future = loop.create_future()

        task = _PromptTask(
            app=app,
            session=session,
            prompt_data=prompt_data,
            future=future,
            loop=loop,
            wait_for_response=True,
            priority=priority,
        )

        # Enhanced concurrent handling - check limits
        with self._lock:
            active_count = len(self._active_tasks)
            if active_count >= self._max_concurrent_prompts:
                import sys
                sys.stderr.write(f"[PermissionManager] Concurrent prompt limit reached ({active_count}/{self._max_concurrent_prompts})\n")
                sys.stderr.flush()
                
                # Cancel oldest prompt to make room (FIFO cleanup)
                if self._active_tasks:
                    oldest_task_id = min(self._active_tasks.keys(), 
                                       key=lambda tid: self._active_tasks[tid].created_at)
                    self.cancel(oldest_task_id)
                    sys.stderr.write(f"[PermissionManager] Auto-cancelled oldest task {oldest_task_id} to make room\n")
                    sys.stderr.flush()

        # Audit log: Task created
        self._audit_log_event('CREATED', task.task_id, {
            'priority': task.priority.name,
            'timeout': timeout,
            'prompt_type': prompt_data.get('title', 'Unknown')
        })
        
        self._put_priority_task(task)

        try:
            if timeout is None:
                result = await future
            else:
                result = await asyncio.wait_for(future, timeout=timeout)
            
            # Cache successful response (Constitution compliant)
            if use_cache and self._cache_enabled and cache_key and result is not None:
                # Only cache non-error responses
                if not isinstance(result, dict) or result.get('response') not in ['timeout', 'cancel', 'error']:
                    self._cache_response(cache_key, result)
                    
                    # Audit log: Cache store
                    self._audit_log_event('CACHE_STORE', cache_key, {
                        'prompt_type': prompt_data.get('title', 'Unknown')
                    })
            
            return result
        except asyncio.TimeoutError:
            # Timeout escalation logic (Constitution compliant)
            escalated = self._escalate_timeout(task)
            if escalated:
                # Re-queue with higher priority and extended timeout
                return await self.prompt(
                    app, session, prompt_data,
                    timeout=timeout * 1.5 if timeout else 45.0,  # 50% longer timeout
                    priority=task.priority  # Keep escalated priority
                )
            else:
                # Max escalations reached - cancel task
                self.cancel(task.task_id)
                raise

    async def show_transient(
        self,
        app: Any,
        session: Any,
        prompt_data: Dict[str, Any],
        *,
        duration: float = 4.0,
    ) -> None:
        task = _PromptTask(
            app=app,
            session=session,
            prompt_data=prompt_data,
            future=None,
            loop=None,
            wait_for_response=False,
        )
        
        # Set up auto-dismiss timer (Constitution compliant - non-blocking)
        async def auto_clear(target: _PromptTask) -> None:
            try:
                # Wait for specified duration with cancellation support
                for _ in range(int(duration * 20)):  # 50ms polls for Constitution compliance
                    if target.cancellation_token.is_set():
                        # Timer cancelled - exit cleanly
                        import sys
                        sys.stderr.write(f"[PermissionManager] Auto-dismiss timer cancelled for task {target.task_id}\n")
                        sys.stderr.flush()
                        return
                    await asyncio.sleep(0.05)  # 50ms polling - Constitution Principle I
                
                # Duration elapsed - auto-dismiss
                import sys
                sys.stderr.write(f"[PermissionManager] Auto-dismissing task {target.task_id} after {duration}s\n")
                sys.stderr.flush()
                target.state = PromptState.AUTO_DISMISSED
                self.clear(task=target)
            except asyncio.CancelledError:
                # Task cleanup cancelled - expected behavior
                import sys
                sys.stderr.write(f"[PermissionManager] Auto-dismiss timer cleanly cancelled for task {target.task_id}\n")
                sys.stderr.flush()
            except Exception as e:
                # Unexpected error - log but don't crash
                import sys
                sys.stderr.write(f"[PermissionManager] Error in auto-dismiss timer for task {target.task_id}: {e}\n")
                sys.stderr.flush()

        task.auto_dismiss_timer = asyncio.create_task(auto_clear(task))
        self._put_priority_task(task)

    async def batch_prompt(
        self,
        app: Any,
        session: Any,
        batch_prompts: List[Dict[str, Any]],
        *,
        timeout: Optional[float] = 30.0,
        priority: PromptPriority = PromptPriority.NORMAL,
        sequential: bool = True,  # True = one at a time, False = concurrent
    ) -> List[Optional[Dict[str, Any]]]:
        """Handle multiple permission prompts (Constitution compliant)
        
        Args:
            batch_prompts: List of prompt_data dictionaries
            sequential: If True, show prompts one by one. If False, allow concurrent.
            
        Returns:
            List of responses in same order as input prompts
        """
        if not batch_prompts:
            return []
        
        import sys
        sys.stderr.write(f"[PermissionManager] Processing batch of {len(batch_prompts)} prompts (sequential={sequential})\n")
        sys.stderr.flush()
        
        if sequential:
            # Sequential processing - one prompt at a time
            results = []
            for i, prompt_data in enumerate(batch_prompts):
                try:
                    # Add batch context to prompt data
                    batch_prompt_data = {
                        **prompt_data,
                        'batch_info': {
                            'current': i + 1,
                            'total': len(batch_prompts),
                            'sequential': True
                        }
                    }
                    
                    result = await self.prompt(
                        app, session, batch_prompt_data,
                        timeout=timeout,
                        priority=priority
                    )
                    results.append(result)
                except Exception as e:
                    sys.stderr.write(f"[PermissionManager] Batch prompt {i+1} failed: {e}\n")
                    sys.stderr.flush()
                    results.append(None)
            
            return results
        else:
            # Concurrent processing - all prompts at once
            import asyncio
            
            async def single_prompt(i: int, prompt_data: Dict[str, Any]) -> Optional[Dict[str, Any]]:
                try:
                    batch_prompt_data = {
                        **prompt_data,
                        'batch_info': {
                            'current': i + 1,
                            'total': len(batch_prompts),
                            'sequential': False
                        }
                    }
                    
                    return await self.prompt(
                        app, session, batch_prompt_data,
                        timeout=timeout,
                        priority=priority
                    )
                except Exception as e:
                    sys.stderr.write(f"[PermissionManager] Concurrent batch prompt {i+1} failed: {e}\n")
                    sys.stderr.flush()
                    return None
            
            # Run all prompts concurrently
            tasks = [single_prompt(i, prompt_data) for i, prompt_data in enumerate(batch_prompts)]
            results = await asyncio.gather(*tasks, return_exceptions=True)
            
            # Convert exceptions to None
            final_results = []
            for result in results:
                if isinstance(result, Exception):
                    final_results.append(None)
                else:
                    final_results.append(result)
            
            return final_results

    def update(self, prompt_data: Dict[str, Any]) -> None:
        with self._lock:
            task = self._current
            if not task:
                return

            def _update() -> None:
                try:
                    prompt_input = task.app.query_one("#prompt-input")
                    prompt_input.permission_prompt_data = prompt_data
                    prompt_input.permission_selected_option = prompt_data.get('selected', 0)
                    prompt_input.focus()  # CRITICAL: Maintain focus during updates!
                    prompt_input.refresh()
                except Exception:
                    pass

            # Thread-safe update: detect if we're in app's async thread or worker thread
            try:
                asyncio.get_running_loop()
                # We're in the async thread - call directly
                _update()
            except RuntimeError:
                # We're NOT in the async thread - use call_from_thread
                task.app.call_from_thread(_update)

    def resolve(self, option: Dict[str, Any]) -> bool:
        return self._resolve_current(option, force=False)

    def clear(self, task: Optional[_PromptTask] = None) -> bool:
        return self._resolve_current({'response': 'cancel'}, force=True, task_filter=task)

    def cancel(self, task_id: str) -> bool:
        """Cancel a specific permission task by ID (Constitution compliant - non-blocking)"""
        with self._lock:
            # Find task in active tasks
            if task_id not in self._active_tasks:
                return False
                
            task = self._active_tasks[task_id]
            
            # Set cancellation token (asyncio.Event for non-blocking)
            task.cancellation_token.set()
            task.state = PromptState.CANCELLED
            
            # Execute cancellation callback if provided
            if task.cancellation_callback:
                try:
                    task.cancellation_callback(task)
                except Exception:
                    pass  # Don't let callback errors break cancellation
            
            # If this is the current task, resolve it
            if self._current and self._current.task_id == task_id:
                return self._resolve_current({'response': 'cancelled'}, force=True)
            
            return True

    def get_active_task_count(self) -> int:
        """Get count of active tasks for monitoring"""
        with self._lock:
            return len(self._active_tasks)

    def get_concurrent_prompt_status(self) -> Dict[str, Any]:
        """Get detailed status of concurrent prompt handling (Constitution compliant)"""
        with self._lock:
            return {
                'active_count': len(self._active_tasks),
                'max_concurrent': self._max_concurrent_prompts,
                'history_count': len(self._prompt_history),
                'concurrent_mode': self._concurrent_mode,
                'current_task_id': self._current.task_id if self._current else None,
                'active_task_ids': list(self._active_tasks.keys()),
                'queue_approximate_size': self._get_queue_size()
            }

    def cancel_all_active_tasks(self) -> int:
        """Cancel all active permission tasks (Constitution compliant emergency cleanup)"""
        cancelled_count = 0
        with self._lock:
            # Cancel all active tasks
            for task_id in list(self._active_tasks.keys()):
                if self.cancel(task_id):
                    cancelled_count += 1
            
            # Clear current task
            if self._current:
                self._current.cancellation_token.set()
                self._current.state = PromptState.CANCELLED
                self._current = None
        
        import sys
        sys.stderr.write(f"[PermissionManager] Emergency cleanup cancelled {cancelled_count} active tasks\n")
        sys.stderr.flush()
        return cancelled_count

    def cancel_batch_by_prefix(self, task_id_prefix: str) -> int:
        """Cancel all tasks with matching ID prefix (Constitution compliant batch cancellation)"""
        cancelled_count = 0
        with self._lock:
            # Find all tasks with matching prefix
            matching_task_ids = [
                task_id for task_id in self._active_tasks.keys()
                if task_id.startswith(task_id_prefix)
            ]
            
            # Cancel each matching task
            for task_id in matching_task_ids:
                if self.cancel(task_id):
                    cancelled_count += 1
        
        import sys
        sys.stderr.write(f"[PermissionManager] Batch cancelled {cancelled_count} tasks with prefix '{task_id_prefix}'\n")
        sys.stderr.flush()
        return cancelled_count

    def shutdown(self) -> None:
        """Shutdown the permission buffer manager (Constitution compliant cleanup)"""
        self._running = False
        # Wake up worker thread so it can exit
        with self._queue_condition:
            self._queue_condition.notify()
        
        # Wait for worker thread to finish
        if self._worker.is_alive():
            self._worker.join(timeout=1.0)

    def cleanup_orphaned_prompts(self, max_age_seconds: float = 30.0) -> int:
        """Cleanup orphaned prompts that have been active too long (Constitution compliant)
        
        Returns number of orphaned prompts cleaned up.
        """
        import time
        current_time = time.time()
        orphaned_count = 0
        
        with self._lock:
            # Find orphaned tasks (active too long)
            orphaned_task_ids = []
            for task_id, task in self._active_tasks.items():
                age_seconds = current_time - task.created_at
                if age_seconds > max_age_seconds:
                    # Task has been active too long - consider orphaned
                    orphaned_task_ids.append(task_id)
                    import sys
                    sys.stderr.write(f"[PermissionManager] Found orphaned task {task_id} (age: {age_seconds:.1f}s)\n")
                    sys.stderr.flush()
            
            # Clean up orphaned tasks
            for task_id in orphaned_task_ids:
                if task_id in self._active_tasks:
                    task = self._active_tasks[task_id]
                    
                    # Cancel auto-dismiss timer if active
                    if task.auto_dismiss_timer and not task.auto_dismiss_timer.done():
                        try:
                            task.auto_dismiss_timer.cancel()
                        except Exception:
                            pass
                    
                    # Set cancellation token
                    task.cancellation_token.set()
                    task.state = PromptState.CANCELLED
                    
                    # Remove from tracking
                    del self._active_tasks[task_id]
                    orphaned_count += 1
                    
                    import sys
                    sys.stderr.write(f"[PermissionManager] Cleaned up orphaned task {task_id}\n")
                    sys.stderr.flush()
            
            # Clean up current task if it's orphaned
            if self._current and self._current.task_id in orphaned_task_ids:
                import sys
                sys.stderr.write(f"[PermissionManager] Current task is orphaned - clearing\n")
                sys.stderr.flush()
                self._current = None
        
        return orphaned_count

    async def _periodic_cleanup(self) -> None:
        """Periodic cleanup task to remove orphaned prompts (Constitution compliant - non-blocking)"""
        import asyncio
        
        while self._running:
            try:
                # Clean up orphaned prompts every 10 seconds
                await asyncio.sleep(10.0)
                
                if not self._running:
                    break
                    
                # Run cleanup (quick operation with locks)
                orphaned_count = self.cleanup_orphaned_prompts(max_age_seconds=30.0)
                
                if orphaned_count > 0:
                    import sys
                    sys.stderr.write(f"[PermissionManager] Periodic cleanup removed {orphaned_count} orphaned prompts\n")
                    sys.stderr.flush()
                    
            except asyncio.CancelledError:
                # Cleanup task was cancelled - exit cleanly
                break
            except Exception as e:
                # Log error but continue cleanup cycle
                import sys
                sys.stderr.write(f"[PermissionManager] Error in periodic cleanup: {e}\n")
                sys.stderr.flush()

    def _run(self) -> None:
        while self._running:
            task = self._get_priority_task()
            if task is None:
                break

            with self._lock:
                self._current = task
                # Track task for cancellation support
                self._active_tasks[task.task_id] = task
                task.state = PromptState.DISPLAYING
                
                # Audit log: Task displayed
                self._audit_log_event('DISPLAYED', task.task_id, {
                    'priority': task.priority.name,
                    'prompt_type': task.prompt_data.get('title', 'Unknown')
                })
                
                # State transition logging for debugging
                import sys
                sys.stderr.write(f"[PermissionManager] Task {task.task_id} state: QUEUED → DISPLAYING\n")
                sys.stderr.flush()

            def _show() -> None:
                import sys
                try:
                    sys.stderr.write(f"\n[PermissionManager._show] Setting permission prompt\n")
                    sys.stderr.flush()
                    prompt_input = task.app.query_one("#prompt-input")
                    prompt_input.permission_prompt_data = task.prompt_data
                    prompt_input.permission_selected_option = task.prompt_data.get('selected', 0)
                    sys.stderr.write(f"[PermissionManager._show] Calling focus() on widget\n")
                    sys.stderr.flush()
                    prompt_input.focus()  # CRITICAL: Give focus so keyboard events work!
                    sys.stderr.write(f"[PermissionManager._show] Widget has_focus={prompt_input.has_focus}\n")
                    sys.stderr.flush()
                    prompt_input.refresh(layout=True)
                    sys.stderr.write(f"[PermissionManager._show] Prompt shown successfully\n")
                    sys.stderr.flush()
                except Exception as e:
                    sys.stderr.write(f"[PermissionManager._show] ERROR: {e}\n")
                    sys.stderr.flush()

            task.app.call_from_thread(_show)

            if task.wait_for_response:
                import sys
                import asyncio
                sys.stderr.write(f"[PermissionManager] Worker thread using NON-BLOCKING polling (Constitution compliant)\n")
                sys.stderr.flush()
                
                task.state = PromptState.AWAITING_INPUT
                sys.stderr.write(f"[PermissionManager] Task {task.task_id} state: DISPLAYING → AWAITING_INPUT\n")
                sys.stderr.flush()
                
                # NON-BLOCKING polling loop - Constitution Principle I compliance
                while not task.resolved and not task.cancellation_token.is_set():
                    # Check every 50ms to stay under Constitution limit
                    try:
                        # Use asyncio event loop if available, otherwise sleep
                        loop = asyncio.get_event_loop()
                        if loop.is_running():
                            loop.run_until_complete(asyncio.sleep(0.05))
                        else:
                            time.sleep(0.05)
                    except Exception:
                        time.sleep(0.05)  # Fallback to sync sleep
                    
                    # Check for cancellation
                    if task.cancellation_token.is_set():
                        sys.stderr.write(f"[PermissionManager] Task {task.task_id} cancelled via token\n")
                        sys.stderr.flush()
                        break
                
                sys.stderr.write(f"[PermissionManager] Worker thread completed non-blocking wait\n")
                sys.stderr.flush()
            else:
                # Non-response tasks complete immediately
                task.state = PromptState.RESOLVED
                task.done_event.set()

            self._queue.task_done()

    def _resolve_current(
        self,
        option: Dict[str, Any],
        *,
        force: bool,
        task_filter: Optional[_PromptTask] = None,
    ) -> bool:
        with self._lock:
            current = self._current
            if not current or (task_filter is not None and current is not task_filter):
                return False

            if current.resolved and not force:
                return False

            current.resolved = True

            def _clear() -> None:
                try:
                    prompt_input = current.app.query_one("#prompt-input")
                    prompt_input.permission_prompt_data = None
                    prompt_input.permission_selected_option = 0
                    prompt_input.refresh(layout=True)
                except Exception:
                    pass

            # Thread-safe clearing: detect if we're in app's async thread or worker thread
            import sys
            sys.stderr.write(f"\n[PermissionManager.resolve] Clearing permission prompt\n")
            sys.stderr.flush()

            # Check if we're in the app's async thread
            try:
                asyncio.get_running_loop()
                # We're in the async thread - call directly (can't use call_from_thread!)
                sys.stderr.write(f"[PermissionManager.resolve] In async thread - calling _clear() directly\n")
                sys.stderr.flush()
                _clear()
            except RuntimeError:
                # We're NOT in the async thread - use call_from_thread
                sys.stderr.write(f"[PermissionManager.resolve] In worker thread - using call_from_thread()\n")
                sys.stderr.flush()
                current.app.call_from_thread(_clear)

            if current.future and current.loop and not current.future.done():
                current.loop.call_soon_threadsafe(current.future.set_result, option)

            sys.stderr.write(f"[PermissionManager.resolve] Setting done_event to wake worker thread\n")
            sys.stderr.flush()
            current.done_event.set()
            
            # Update state and clean up tracking
            final_state = PromptState.RESOLVED if 'cancelled' not in str(option) else PromptState.CANCELLED
            current.state = final_state
            
            # Audit log: Task resolved
            import time
            self._audit_log_event('RESOLVED' if final_state == PromptState.RESOLVED else 'CANCELLED', 
                                current.task_id, {
                                    'response': str(option),
                                    'forced': force,
                                    'duration_seconds': time.time() - current.created_at
                                })
            
            # Cancel auto-dismiss timer if active (Constitution compliant cleanup)
            if current.auto_dismiss_timer and not current.auto_dismiss_timer.done():
                try:
                    current.auto_dismiss_timer.cancel()
                    sys.stderr.write(f"[PermissionManager.resolve] Cancelled auto-dismiss timer for task {current.task_id}\n")
                    sys.stderr.flush()
                except Exception as timer_error:
                    sys.stderr.write(f"[PermissionManager.resolve] Error cancelling timer for task {current.task_id}: {timer_error}\n")
                    sys.stderr.flush()
            
            # Remove from active tasks tracking and add to history
            if current.task_id in self._active_tasks:
                del self._active_tasks[current.task_id]
                
                # Memory leak prevention - explicit cleanup
                try:
                    current._cleanup_task_resources()
                except Exception as cleanup_error:
                    sys.stderr.write(f"[PermissionManager] Cleanup error for task {current.task_id}: {cleanup_error}\n")
                    sys.stderr.flush()
                
                # Add to history for debugging (Constitution compliant - limited memory)
                self._prompt_history.append(current)
                if len(self._prompt_history) > self._max_history:
                    # Remove oldest history item with cleanup
                    removed = self._prompt_history.pop(0)
                    try:
                        removed._cleanup_task_resources()
                    except Exception:
                        pass
                    sys.stderr.write(f"[PermissionManager] Removed old history item {removed.task_id}\n")
                    sys.stderr.flush()
            
            self._current = None
            sys.stderr.write(f"[PermissionManager.resolve] Resolution complete - task {current.task_id} cleaned up\n")
            sys.stderr.flush()
            return True


_MANAGER: Optional[PermissionBufferManager] = None
_MANAGER_LOCK = threading.Lock()


def get_permission_buffer_manager() -> PermissionBufferManager:
    global _MANAGER
    with _MANAGER_LOCK:
        if _MANAGER is None:
            _MANAGER = PermissionBufferManager()
        return _MANAGER
