        ExecutionType.TOOL,
        'Read',
        file_read,
        ExecutionCategory.FILE,
        RiskLevel.LOW,
        requires_approval=False,
        description="Read file contents"
    )

    executor.registry.register(
        ExecutionType.TOOL,
        'Write',
        file_write,
        ExecutionCategory.FILE,
        RiskLevel.MEDIUM,
        requires_approval=True,
        description="Write/create file (overwrites existing)"
    )

    executor.registry.register(
        ExecutionType.TOOL,
        'Edit',
